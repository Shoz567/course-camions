# Normalisation des fins de ligne.
#
# Le depot est sous Windows mais Godot, Python et make lisent tous le LF sans
# difficulte. On force donc le LF PARTOUT — dans le depot et dans la copie de
# travail — plutot que de laisser git convertir en CRLF au checkout.
#
# Sans cette ligne, chaque commit affiche des dizaines d'avertissements
# "LF will be replaced by CRLF", et un futur collaborateur sous Linux verrait
# tout le depot comme modifie.
* text=auto eol=lf

# --- Sources : texte explicite ---
*.gd         text eol=lf
*.py         text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.cfg        text eol=lf
*.sh         text eol=lf
Makefile     text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# --- Formats Godot : texte, malgre les extensions inhabituelles ---
*.tscn       text eol=lf
*.tres       text eol=lf
*.godot      text eol=lf
*.import     text eol=lf
*.uid        text eol=lf

# --- Binaires : jamais de conversion, jamais de diff ---
# Rappel : les .glb sont git-ignores (ils se regenerent avec `make assets`).
# Ces regles protegent le jour ou l'un passerait quand meme.
*.glb        binary
*.gltf       binary
*.blend      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.ogg        binary
*.wav        binary
*.mp3        binary
*.ttf        binary
*.otf        binary
*.exe        binary
*.pck        binary
*.zip        binary

# --- Modeles fournis par l'equipe : Git LFS (decision du 2026-10-02) ---
# Les .glb d'Assets_Visuels/ (camions dessines a la main, pas generes par
# `make assets`) sont versionnes, mais stockes hors de l'historique par Git
# LFS : `git lfs install` une fois par machine (docs/ENVIRONMENT.md §6.7).
Assets_Visuels/**/*.glb filter=lfs diff=lfs merge=lfs -text

# --- Diff plus lisible sur les fichiers de contrat ---
# baseline.json est versionne et relu a chaque fin de phase : on veut un diff
# propre dessus (cf. CLAUDE.md §8).
game/tests/baseline.json text eol=lf diff

# --- Musiques (2026-10-22) : morceaux CC0 de MintoDog (OpenGameArt), 3 a 7 Mo
# chacun, en Git LFS comme les modeles de l'equipe (game/audio/music/CREDITS.md).
game/audio/music/*.ogg filter=lfs diff=lfs merge=lfs -text
game/audio/music/*.mp3 filter=lfs diff=lfs merge=lfs -text
