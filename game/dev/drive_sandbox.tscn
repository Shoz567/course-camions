[sub_resource type="Shader" id="shader_checker"]
code = "shader_type spatial;

// Damier de 4 m en coordonnees monde : donne la sensation de vitesse.
varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float c = mod(floor(world_pos.x / 4.0) + floor(world_pos.z / 4.0), 2.0);
	ALBEDO = mix(vec3(0.28, 0.31, 0.28), vec3(0.36, 0.40, 0.35), c);
	ROUGHNESS = 0.9;
}
"

