[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="shader"]
code = "shader_type spatial;
render_mode cull_disabled;

// Glissiere de la ville : panneaux d'acier sombre de 6 m (joints, liseres),
// mouilles par la pluie (coulures brillantes), rayes et frottes au pied par
// les camions ; le neon court le long de son bord haut (maillage a part).
// UV.y en m.
#include \"res://tracks/materials/asphalt.gdshaderinc\"

void fragment() {
	vec2 p = vec2(UV.x * 1.1, UV.y);
	float seam = smoothstep(0.93, 0.97, fract(UV.y / 6.0));
	float face = fract(UV.x);
	float k = a_detail(p, 6.0);
	float grain = a_noise(p * vec2(2.0, 6.0)) * k + 0.5 * (1.0 - k);
	vec3 metal = vec3(0.05, 0.055, 0.07) * (0.85 + 0.3 * grain) * (1.0 - 0.45 * seam);
	// liseres horizontaux discrets sur la face
	metal += vec3(0.02, 0.025, 0.04) * step(0.46, face) * step(face, 0.5);
	// rayures au pied : metal nu, plus clair
	float scratch = smoothstep(0.72, 0.8, a_noise(vec2(UV.y * 0.7, face * 30.0))) * (1.0 - smoothstep(0.15, 0.4, face));
	metal = mix(metal, vec3(0.3, 0.3, 0.32), scratch * 0.6);
	// coulures d'eau : bandes verticales plus lisses
	float run = smoothstep(0.5, 0.8, a_noise(vec2(UV.y * 2.5, face * 0.8)));
	ALBEDO = metal;
	METALLIC = 0.7;
	ROUGHNESS = mix(0.42, 0.12, run) + 0.15 * grain;
	NORMAL = asphalt_bump(NORMAL, VERTEX, (grain - seam * 2.0) * 0.003, 1.0);
}
"

[resource]
shader = SubResource("shader")
