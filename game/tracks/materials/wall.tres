[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="shader"]
code = "shader_type spatial;
render_mode cull_disabled;

// Glissiere : bandes rouges et blanches de 4 m le long de la piste (UV.y en m).
void fragment() {
	float band = mod(floor(UV.y / 4.0), 2.0);
	ALBEDO = mix(vec3(0.85, 0.12, 0.10), vec3(0.93), band);
	ROUGHNESS = 0.6;
}
"

[resource]
shader = SubResource("shader")
