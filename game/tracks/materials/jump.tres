[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="shader"]
code = "shader_type spatial;
render_mode cull_disabled;

// Tremplin : orange a chevrons, visible de loin (principe de lisibilite).
varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float c = mod(floor((world_pos.x + world_pos.z) / 1.5), 2.0);
	ALBEDO = mix(vec3(0.95, 0.50, 0.08), vec3(0.15, 0.12, 0.10), c * 0.8);
	ROUGHNESS = 0.7;
}
"

[resource]
shader = SubResource("shader")
