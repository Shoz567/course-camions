[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="shader"]
code = "shader_type spatial;

// Chaussee de nuit (Cyber City) : bitume sombre a grain fin, legerement humide
// (les neons s'y refletent), marquages blancs nets, antialiases.
// UV.x : 0 (bord gauche) .. 1 (bord droit). UV.y : distance le long de la
// piste (m) ; ligne d'arrivee a 0.
uniform float road_width = 75.0;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

// 1 sur une bande [a, b] (m), bords adoucis sur un pixel
float band(float x, float a, float b) {
	float w = fwidth(x);
	return smoothstep(a - w, a + w, x) * (1.0 - smoothstep(b - w, b + w, x));
}

void fragment() {
	float x = UV.x * road_width;
	float s = UV.y;
	vec2 p = vec2(x, s);
	float grain = vnoise(p * 1.7) * 0.6 + vnoise(p * 7.0) * 0.4;
	float patch = vnoise(p * 0.05);
	vec3 col = vec3(0.032, 0.034, 0.042) * (0.8 + 0.45 * grain) * (0.85 + 0.3 * patch);
	float paint = 0.0;
	// lignes de bord continues, a 0,8 m des murs
	paint += band(x, 0.8, 1.15) + band(x, road_width - 1.15, road_width - 0.8);
	// voies : pointilles de 9 m, tous les quarts de largeur
	float dash = step(fract(s / 18.0), 0.5);
	for (int k = 1; k < 4; k++) {
		float c = road_width * float(k) / 4.0;
		paint += band(x, c - 0.14, c + 0.14) * dash;
	}
	paint = clamp(paint, 0.0, 1.0);
	col = mix(col, vec3(0.82), paint);
	// ligne d'arrivee : damier sur 3 m
	if (s >= 0.0 && s < 3.0) {
		float c = mod(floor(UV.x * 28.0) + floor(s * 2.0), 2.0);
		col = mix(vec3(0.02), vec3(0.9), c);
		paint = 1.0;
	}
	ALBEDO = col;
	// peinture a peine lumineuse : lisible dans la nuit
	EMISSION = vec3(0.12) * paint;
	ROUGHNESS = mix(0.32, 0.6, grain) + paint * 0.2;
	SPECULAR = 0.6;
}
"

[resource]
shader = SubResource("shader")
