[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="shader"]
code = "shader_type spatial;

// Herbe : damier de 8 m en coordonnees monde, pour lire la vitesse hors piste.
varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float c = mod(floor(world_pos.x / 8.0) + floor(world_pos.z / 8.0), 2.0);
	ALBEDO = mix(vec3(0.20, 0.36, 0.16), vec3(0.24, 0.42, 0.19), c);
	ROUGHNESS = 0.95;
}
"

[resource]
shader = SubResource("shader")
