# Godot
.godot/
game/.godot/
*.translation

# Assets generes par Blender : ils se regenerent avec `make assets`
game/assets/generated/

# Modeles de l'equipe : les .glb sont versionnes via Git LFS (.gitattributes) ;
# les sources (.fbx...) restent hors depot. Exception : les .blend du
# catalogue (Armes_et_camions/, make publish-assets), aussi via Git LFS.
Assets_Visuels/**
!Assets_Visuels/**/
!Assets_Visuels/**/*.glb
!Assets_Visuels/Armes_et_camions/**/*.blend

# Blender
# Un .blend par modele du catalogue (make assets) : copies de consultation,
# la source de verite reste tools/blender/.
blend/
*.blend1
*.blend2

# Python (les scripts de build sont importes comme modules par Blender)
__pycache__/
*.pyc

# Spikes (phase 0.5) : code jetable, supprime en fin de phase
spike/

# Builds
builds/
*.exe
*.pck
*.zip

# OS / editeurs
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# IMPORTANT : baseline.json EST versionne (cf. CLAUDE.md §8).
# Ne pas l'ignorer : c'est la reference de non-regression du projet.
!game/tests/baseline.json
